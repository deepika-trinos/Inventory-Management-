# ---------------------------------------------------------------------------
# DEVELOPMENT settings template.
# Copy this file to ".env" (same folder) and fill in your own values:
#     copy .env.example .env        (Windows)
# ".env" is listed in .gitignore and must NEVER be committed.
# For a production server, start from .env.production.example instead.
# ---------------------------------------------------------------------------

# Which environment this is: development | test | production
APP_ENV=development

# Main database the app uses.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Development-only values; never use them for production.
# Port 5433 = the project's own dev database server (scripts\dev-db), or the
# Docker database (docker-compose.yml). Both use the same user and password.
DATABASE_URL=postgresql+psycopg://itam_app:itam_dev_password@localhost:5433/itam_dev

# Separate database used ONLY by pytest. Tests may delete data here,
# so it must never point at the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://itam_app:itam_dev_password@localhost:5433/itam_test

# Web addresses allowed to call the API from a browser (CORS), comma-separated.
# 5173 is the Vite dev server's default port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timezone used to DISPLAY dates (all times are stored in UTC). Decision Q11.
APP_TIMEZONE=Asia/Kolkata

# Print every SQL statement to the console (handy while learning). true | false
SQL_ECHO=false

# ---- Login tokens (JWT) ----
# Secret used to sign login tokens. Make your own random one (at least 32 characters):
#     .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it out of Git. Changing it logs everybody out.
JWT_SECRET_KEY=change-me-to-a-long-random-secret-of-at-least-32-characters
# Minutes a login token stays valid. Short = safer; the user simply logs in again.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Minimum length for new passwords.
PASSWORD_MIN_LENGTH=12

# ---- First Admin account (optional; used by: python -m app.scripts.create_admin) ----
# Leave these empty and the script will ask you instead (safer: nothing saved to disk).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
