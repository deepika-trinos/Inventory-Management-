# ---------------------------------------------------------------------------
# PRODUCTION settings template (used in Slice 8.5, go-live).
# On the production server, copy this to ".env" or set the same names as real
# environment variables in the hosting provider's dashboard.
# Never commit the filled-in file. Use a strong, unique database password.
# ---------------------------------------------------------------------------

APP_ENV=production

DATABASE_URL=postgresql+psycopg://<user>:<strong-password>@<db-host>:5432/<db-name>

# Only the real website address. Do NOT include localhost here.
CORS_ORIGINS=https://<your-domain>

APP_TIMEZONE=Asia/Kolkata

SQL_ECHO=false
