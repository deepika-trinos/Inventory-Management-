# Copy this file to ".env" in the same folder:   copy .env.example .env
# Only variables starting with VITE_ are visible to the React code.
# Everything here ends up inside the browser, so NEVER put secrets in this file.

# Address of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Company timezone for showing dates (decision Q11). Must match APP_TIMEZONE in backend/.env.
VITE_APP_TIMEZONE=Asia/Kolkata
